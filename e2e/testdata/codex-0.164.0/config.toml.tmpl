# T27 真实 Codex CLI E2E 的临时 CODEX_HOME 配置。
#
# 刻意不设置任何模型目录覆盖项：模型名来自 harness seed 的 model_routes，
# Codex 必须自行请求网关的 /v1/models 做模型发现。
model = "{{.Model}}"
model_provider = "e2e-gateway"
approval_policy = "never"
sandbox_mode = "read-only"

[model_providers.e2e-gateway]
name = "e2e-gateway"
base_url = "{{.BaseURL}}"
# Codex 0.164.0 只有在 provider 显式配置远端模型目录 URL 时才会请求
# /v1/models?client_version=...。这不是本地模型目录缓存文件。
model_catalog_url = "{{.ModelCatalogURL}}"
wire_api = "responses"
supports_websockets = false
requires_openai_auth = false
experimental_bearer_token = "{{.ClientKey}}"
# 断流子测试只关心网关写出一次 response.failed；禁用 Codex 自身的流重连，
# 避免把客户端重试误计入上游尝试次数。
stream_max_retries = 0
